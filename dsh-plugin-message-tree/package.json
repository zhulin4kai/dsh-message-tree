{
  "name": "dsh-plugin-message-tree",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "description": "DSH 消息树 Host：分支存储、编辑/回退、模型与工作区继承、附件重发。",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "displayName": "DSH-消息树",
    "description": "在同一个对话内回退、编辑和切换分支，侧边栏始终只显示当前分支。"
  }
}
