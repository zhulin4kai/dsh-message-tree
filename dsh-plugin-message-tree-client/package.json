{
  "name": "dsh-plugin-message-tree-client",
  "version": "0.3.7",
  "private": true,
  "type": "module",
  "description": "DSH 消息树界面：分支操作、原生输入框回退、附件恢复与树级菜单。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "displayName": "DSH-消息树界面",
    "description": "消息树的侧边栏与消息操作界面。"
  }
}
